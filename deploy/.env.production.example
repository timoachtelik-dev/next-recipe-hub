NODE_ENV=production
PORT=3010

# App URL
NEXTAUTH_URL=https://demo-recipe-hub.timo-achtelik.de
NEXTAUTH_SECRET=change-me

# Database
POSTGRES_USER=recipehub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=next_recipe_hub
DATABASE_URL=postgresql://recipehub:change-me@localhost:5432/next_recipe_hub?schema=public

# Email (optional)
# Set EMAIL_SERVER=true to enable EmailProvider
EMAIL_SERVER=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@demo-recipe-hub.timo-achtelik.de

# Seeded demo owner (used by import/seed scripts)
SEED_USER_EMAIL=demo@timo-achtelik.de
SEED_USER_NAME=Demo User

# OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
